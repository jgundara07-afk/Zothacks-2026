# Copy to frontend/.env.local, then use values from your own Supabase project.
# Dashboard: project Connect dialog, or Settings > API Keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects can use VITE_SUPABASE_ANON_KEY instead of the publishable key.
# VITE_SUPABASE_ANON_KEY=
# NEVER place sb_secret_* or a service_role JWT in a VITE_* variable.
