# Leave empty for local SQLite profile storage; use MongoDB for deployment.
MONGO_URI=
MONGO_DB=one_thing
PORT=5001

# Optional manual opportunity collection (never used by the running demo).
MUSE_API_KEY=
# Reserved for a future authenticated Coursera adapter; public courses.v1 does not use it.
COURSERA_API_KEY=
# Optional comma-separated Muse categories; see opportunity_data/README.md.
EVENTBRITE_TOKEN=
EVENTBRITE_ORGANIZATION_IDS=
EVENTBRITE_EVENT_IDS=
# Optional comma-separated public ZotSpot event detail URLs.
ZOTSPOT_DETAIL_URLS=

# catalog (default) or sample (explicit fictional fixture)
ONETHING_DATA_MODE=catalog

# Optional Gemini fallback suggestion when the catalog has no personalized match.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Supabase Auth server verification (same project URL and publishable key as frontend).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative: SUPABASE_ANON_KEY=
